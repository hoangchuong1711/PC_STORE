# Dùng cho Docker Compose chạy frontend + backend + PostgreSQL local.
POSTGRES_PASSWORD=local-only-password
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Brevo HTTPS API. Use a verified sender; never commit the real API key.
MAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM_EMAIL=
