DEMO_SEED_ENABLED=false
DEMO_ACCOUNTS_ENABLED=false

CLOUDINARY_CLOUD_NAME=ten_cloud_cua_m
CLOUDINARY_API_KEY=123456789...
CLOUDINARY_API_SECRET=abcxyz...

VNPAY_ENABLED=false
VNPAY_TMN_CODE=PCSTORE1
VNPAY_HASH_SECRET=ABCXYZSECRET123456789...
